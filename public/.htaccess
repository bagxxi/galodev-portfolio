# ==========================================
# SECURITY RULES
# ==========================================

# Block access to sensitive files and directories
<FilesMatch "(^\..*|\.env.*|\.git.*|package\.json|package-lock\.json|tsconfig\.json|astro\.config\..*|\.eslintrc.*|\.prettierrc.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Block directory browsing
Options -Indexes

# Block access to hidden directories
RedirectMatch 404 /\.(.*)

# Real 404 page (static site: unknown routes must not return 200)
ErrorDocument 404 /404.html

# Short links
RedirectMatch 301 ^/linkedin/?$ https://www.linkedin.com/in/galodev/

# ==========================================
# HTTPS
# ==========================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS (also respects TLS terminated at a proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ==========================================
# SECURITY HEADERS
# ==========================================

<IfModule mod_headers.c>
  # HSTS: one year. Add "includeSubDomains; preload" only after confirming
  # that every subdomain of the domain is served over HTTPS.
  # (Browsers ignore this header on plain HTTP responses.)
  Header always set Strict-Transport-Security "max-age=31536000"

  # Prevent clickjacking (also covered by frame-ancestors below)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Legacy XSS auditor is deprecated and can introduce issues: disable it explicitly
  Header always set X-XSS-Protection "0"

  # Control referrer information
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Cross-origin isolation of the browsing context and resources
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Content Security Policy.
  # Inline scripts are allowed only by SHA-256 hash: the hash placeholder is
  # replaced at build time by scripts/csp-hashes.mjs (see dist/.htaccess).
  # 'unsafe-inline' stays only in style-src (inline style attributes).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https://*.jamendo.com; media-src 'self' blob: https://*.jamendo.com; connect-src 'self' https://api.jamendo.com; frame-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Permissions Policy (formerly Feature-Policy)
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), fullscreen=(self)"
</IfModule>

# ==========================================
# PERFORMANCE
# ==========================================

# Habilitar compresión GZIP
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache de archivos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>
