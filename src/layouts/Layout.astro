              "Prueba Hospital de Medianoche, un juego 3D que corre directo en el navegador.",
          },
          en: {
            "nav.home": "Home",
            "nav.about": "About me",
            "nav.projects": "Projects",
            "nav.skills": "Skills",
            "nav.contact": "Contact",
            "nav.music": "Music",
            "nav.games": "Games",
            "nav.skip": "Skip to content",
            "nav.discover": "Discover",
            "nav.genres": "Genres",
            "nav.viewProjects": "View Projects",
            "greeting.hello": "Hi, I'm",
            "greeting.morning": "Good morning",
