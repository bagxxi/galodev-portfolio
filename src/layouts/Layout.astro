            "music.jamendo_title": "Música con Jamendo",
            "music.cc_a": "Todas las canciones son",
            "music.cc_b": ": libres para escuchar y compartir.",
            "music.genre.metal": "Heavy riffs y power",
            "music.genre.rock": "Rock clásico y moderno",
            "music.genre.hiphop": "Beats underground",
            "music.genre.electronic": "EDM y synth",
            "music.genre.jazz": "Jazz contemporáneo",
            "music.genre.classical": "Orquestal",
