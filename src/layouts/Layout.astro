            "music.genre.classical": "Orchestral",
            "notfound.title": "Page not found",
            "notfound.text":
              "The page you are looking for does not exist or has been moved.",
            "notfound.back": "Back to home",
            "about.title": "About Me",
            "about.subtitle": "My journey in development",
            "about.description":
              "I am a full stack developer passionate about creating elegant and efficient solutions.",
            "about.bio_full":
              "Passionate developer focused on building modern and efficient web experiences.",
            "about.location": "Location:",
            "about.timezone": "Timezone:",
            "about.repos": "Repositories",
            "about.techs": "Technologies",
            "about.github_status": "GitHub Status",
            "about.years": "Years Dev",
            "about.location_val": "Chile",
            "about.timezone_val": "UTC -03:00",
            "skills.title": "Technical Skills",
            "skills.subtitle": "My technical toolbox",
            "contact.title": "Contact",
            "contact.subtitle": "Have a project in mind?",
            "contact.form_send": "Send Message",
            "contact.email_label": "Email",
            "contact.location_label": "Location",
            "contact.status_label": "Status",
            "contact.github_label": "GitHub",
            "contact.response_time": "Response time",
            "info.title": "Full Stack Developer",
            "info.status": "Available for projects",
            // Project details
            "projects.hormiga-app.description":
              "Personal finance application with expense tracking, budgets, and monthly savings.",
            "projects.alejandra-balbontin.description":
              "Documentary photography and cinematography portfolio with embedded video and a minimalist design.",
            "projects.inversiones-byg.description":
              "Corporate website for a real estate investment company. Professional and SEO-optimized design.",
            "projects.photography-portfolio.description":
              "Professional photography portfolio site with interactive gallery and modern design.",
            // Games
            "games.title": "Games",
            "games.subtitle":
              "Playable projects built with JavaScript. They run in the browser and on mobile.",
            "games.play": "Play",
            "games.fullscreen": "Fullscreen",
            "games.exitFullscreen": "Exit fullscreen",
            "games.newTab": "Open in new tab",
            "games.controls": "Controls",
            "games.hospital-medianoche.description":
              "Cozy-horror 3D game. You are the night-shift intern: treat sick little animals, find their remedies and spot the anomalies before they sneak into the hospital.",
            "games.hospital-medianoche.controls":
              "WASD or arrow keys to walk, drag to look, E to interact. On mobile: joystick and Use button.",
            "games.teaser":
              "Try Hospital de Medianoche, a 3D game that runs right in your browser.",
          },
        };

        elements.forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (translations[currentLang] && translations[currentLang][key]) {
            el.textContent = translations[currentLang][key];
          }
        });

        // Translate document title. Each entry lists both languages so the
        // current title can be matched whichever language it is in (ES <-> EN).
        const pageTitles = [
          { es: "Inicio", en: "Home" },
          { es: "Sobre mí", en: "About Me" },
          { es: "Proyectos", en: "Projects" },
          { es: "Skills", en: "Skills" },
          { es: "Contacto", en: "Contact" },
          { es: "Música", en: "Music" },
          { es: "Juegos", en: "Games" },
          { es: "Página no encontrada", en: "Page not found" },
        ];
        const parts = document.title.split(" | ");
        const match = pageTitles.find(
          (t) => t.es === parts[0] || t.en === parts[0],
        );
        if (match && parts.length > 1) {
          parts[0] = match[currentLang] || match.es;
          document.title = parts.join(" | ");
        }
      }

      // Expose globally for Toggles
      window.translatePage = translatePage;

      // Initialize Language
      function initApp() {
        applyLang();
      }

      // Initial apply
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initApp);
      } else {
        initApp();
      }

      // Handle Astro page transitions
      document.addEventListener("astro:after-swap", () => {
        initApp();
      });
    </script>
  </head>
  <body class="bg-void text-text font-body transition-colors duration-300">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-md focus:bg-accent-cyan focus:text-void focus:font-semibold"
      data-i18n="nav.skip">Saltar al contenido</a
    >
    <div id="app" class="relative p-2 gap-2">
      <aside
        class="[grid-area:aside] flex-col flex overflow-x-hidden overflow-y-auto"
      >
        <AsideMenu />
      </aside>
      <main
        id="main-content"
        tabindex="-1"
        class="[grid-area:main] rounded-lg bg-surface overflow-y-auto overflow-x-hidden w-full min-w-0 relative transition-colors duration-300 focus:outline-none"
      >
        <!-- Dot grid background -->
        <div
          aria-hidden="true"
          class="absolute inset-0 bg-dot-grid pointer-events-none dark:opacity-30 opacity-10"
        >
        </div>
        <div class="relative z-10 text-text">
          <slot />
        </div>
      </main>

      <footer
        class="[grid-area:player] h-[64px] md:h-[80px] bg-surface transition-colors duration-300 rounded-lg"
      >
        <Player client:load transition:name="media-player" transition:persist />
      </footer>
    </div>

    <style>
      #app {
        display: grid;
        grid-template-areas:
          "main"
          "player"
          "aside";
        grid-template-columns: 1fr;
        grid-template-rows: minmax(0, 1fr) auto auto;
        height: 100vh;
        /* dvh accounts for mobile browser toolbars */
        height: 100dvh;
        overflow: hidden;
        padding-bottom: max(0.5rem, env(safe-area-inset-bottom));
      }

      @media (min-width: 768px) {
        #app {
          grid-template-areas:
            "aside main"
            "player player";
          grid-template-columns: 240px minmax(0, 1fr);
          grid-template-rows: minmax(0, 1fr) auto;
        }
      }

      /* Desktop - full sidebar */
      @media (min-width: 1024px) {
        #app {
          grid-template-columns: 320px minmax(0, 1fr);
        }
      }
    </style>
    <style is:global>
      :root {
        /* Color tokens live in src/styles/global.css (@theme).
           RGB values for transparency extensions: */
        --color-void-rgb: 9, 9, 11;
        --color-surface-rgb: 18, 18, 22;
        --color-text-rgb: 161, 161, 170;

        /* Transition timing */
        --ease-out-cubic: cubic-bezier(0.22, 1, 0.36, 1);
      }

      html {
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        background: var(--color-void);
        color: var(--color-text);
        transition:
          background-color 0.3s,
          color 0.3s;
      }

      /* Headings use Space Grotesk */
      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        font-family: "Space Grotesk", system-ui, sans-serif;
      }

      /* Mono text */
      code,
      pre,
      .font-mono {
        font-family: "JetBrains Mono", monospace;
      }

      /* Scrollbar styling */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }

      ::-webkit-scrollbar-track {
        background: var(--color-surface);
      }

      ::-webkit-scrollbar-thumb {
        background: var(--color-surface-lighter);
        border-radius: 4px;
      }

      ::-webkit-scrollbar-thumb:hover {
        background: var(--color-accent-cyan);
      }

      /* Selection styling */
      ::selection {
        background: var(--color-accent-magenta);
        color: var(--color-void);
      }

      /* Visible keyboard focus */
      :focus-visible {
        outline: 2px solid var(--color-accent-cyan);
        outline-offset: 2px;
      }

      /* Respect users who prefer less motion */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
          scroll-behavior: auto !important;
        }
      }

      /* Snappy transitions for interactive elements */
      a,
      button {
        transition: all 0.2s var(--ease-out-cubic);
      }

      /* Technical badge style */
      .badge {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
      }

      /* Glassmorphism card */
      .glass-card {
        background: var(--color-surface);
        background-color: rgba(var(--color-surface-rgb), 0.8);
        backdrop-filter: blur(12px);
      }

      /* Typing animation */
      .typing-effect {
        overflow: hidden;
        border-right: 2px solid var(--color-accent-cyan);
        white-space: nowrap;
        animation:
          typing 3s steps(40, end),
          blink-caret 0.75s step-end infinite;
      }

      @keyframes typing {
        from {
          width: 0;
        }
        to {
          width: 100%;
        }
      }

      @keyframes blink-caret {
        from,
        to {
          border-color: transparent;
        }
        50% {
          border-color: var(--color-accent-cyan);
        }
      }

      /* Metadata style for decorative elements */
      .metadata {
        font-family: "JetBrains Mono", monospace;
        font-size: 0.7rem;
        color: var(--color-text-muted);
        letter-spacing: 0.02em;
      }

      /* Version badge */
      .version-badge::before {
        content: "v";
      }
    </style>
    <script>
      import "../scripts/image-fallback";
    </script>
  </body>
</html>
