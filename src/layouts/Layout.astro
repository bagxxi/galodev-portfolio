            "projects.alejandra-balbontin.description":
              "Portafolio de fotografía documental y dirección de fotografía, con videos integrados y diseño minimalista.",
            "projects.inversiones-byg.description":
              "Sitio web corporativo para empresa de inversiones inmobiliarias. Diseño profesional y optimizado para SEO.",
