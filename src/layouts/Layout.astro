---
import AsideMenu from "../components/AsideMenu.astro";
import { ClientRouter } from "astro:transitions";
// Self-hosted fonts (no requests to Google Fonts; each file is limited by unicode-range)
import "@fontsource/space-grotesk/400.css";
import "@fontsource/space-grotesk/500.css";
import "@fontsource/space-grotesk/600.css";
import "@fontsource/space-grotesk/700.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@fontsource/jetbrains-mono/700.css";
import "../styles/global.css";
import { Player } from "@/components/Player.jsx";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark" translate="no">
  <head>
    <meta charset="UTF-8" />
    <meta name="google" content="notranslate" />
    <meta
      name="description"
      content="GaloDev - Desarrollador Full Stack | Portafolio profesional"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />

    <title>{title}</title>
    <ClientRouter fallback="none" />

    <script is:inline>
      // Initialize Language
      function applyLang() {
        // Only accept supported languages from (user-editable) storage
        const stored = localStorage.getItem("lang");
        const lang = stored === "en" || stored === "es" ? stored : "es";
        document.documentElement.setAttribute("lang", lang);
        translatePage();
      }

      function translatePage() {
        const currentLang =
          document.documentElement.getAttribute("lang") || "es";
        const elements = document.querySelectorAll("[data-i18n]");

        const translations = {
          es: {
