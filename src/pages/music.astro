---
import Layout from "../layouts/Layout.astro";
import { MusicSearch } from "@/components/MusicSearch";

// Genre playlists configuration
const genrePlaylists = [
  {
    id: "metal",
    title: "Metal",
    emoji: "🎸",
    color: "#f7768e",
    description: "Heavy riffs y power",
  },
  {
    id: "rock",
    title: "Rock",
    emoji: "🔥",
    color: "#ff9e64",
    description: "Rock clásico y moderno",
  },
  {
    id: "hiphop",
    title: "Hip-Hop",
    emoji: "🎤",
    color: "#9ece6a",
    description: "Beats underground",
  },
  {
    id: "electronic",
    title: "Electrónica",
    emoji: "🎧",
    color: "#7dcfff",
    description: "EDM y synth",
  },
  {
    id: "jazz",
    title: "Jazz",
    emoji: "🎷",
    color: "#bb9af7",
    description: "Jazz contemporáneo",
  },
  {
    id: "classical",
    title: "Clásica",
    emoji: "🎻",
    color: "#9d7cd8",
    description: "Orquestal",
  },
];
---

<Layout title="Música | GaloDev Portfolio">
  <div class="relative px-4 md:px-8 py-12">
    <!-- Page header -->
    <header class="mb-8 max-w-4xl">
      <span class="metadata block mb-4">// music.discover()</span>
      <h1 class="font-display text-4xl md:text-5xl font-bold text-text-bright mb-4">
        <span class="text-accent-green" aria-hidden="true">♫</span>
        <span data-i18n="nav.music">Música</span>
      </h1>
      <p class="text-text-muted text-lg" data-i18n="music.subtitle">
        Descubre y escucha música libre de derechos de autor de Jamendo.
      </p>
    </header>

    <!-- Genre Playlists Grid -->
    <section class="mb-12">
      <h2
        class="font-display text-2xl font-bold text-text-bright mb-6 flex items-center gap-2"
      >
        <span class="text-accent-magenta" aria-hidden="true">★</span>
        <span data-i18n="music.genres_title">Playlists por Género</span>
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
        {
          genrePlaylists.map((genre) => (
            <a
              href={`/genre/${genre.id}`}
              class="group relative overflow-hidden rounded-xl p-4 transition-all hover:scale-105 hover:shadow-xl"
              style={`background: linear-gradient(135deg, ${genre.color}40, ${genre.color}10); border: 1px solid ${genre.color}30;`}
            >
              <div class="text-4xl mb-3" aria-hidden="true">{genre.emoji}</div>
              <h3 class="font-display font-bold text-text-bright group-hover:text-white transition-colors">
                {genre.title}
              </h3>
              <p class="text-xs text-text-muted mt-1" data-i18n={`music.genre.${genre.id}`}>{genre.description}</p>

              <div
                aria-hidden="true"
                class="absolute bottom-2 right-2 w-8 h-8 rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity text-void text-xs"
                style={`background: ${genre.color};`}
              >
                ▶
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- Search Section -->
    <section class="mb-12 glass-card rounded-xl p-6">
      <h2
        class="font-display text-2xl font-bold text-text-bright mb-6 flex items-center gap-2"
      >
        <span class="text-accent-cyan" aria-hidden="true">🔍</span>
        <span data-i18n="music.search_title">Buscar Canciones</span>
      </h2>
      <MusicSearch client:load />
    </section>

    <!-- Info Card -->
    <section class="glass-card rounded-xl p-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4">
        <div
          class="w-12 h-12 bg-accent-cyan/20 rounded-full flex items-center justify-center text-2xl"
        >
          🎵
        </div>
        <div>
          <h3 class="font-display font-bold text-text-bright">
            <span data-i18n="music.jamendo_title">Música con Jamendo</span>
          </h3>
          <p class="text-sm text-text-muted">
            <span data-i18n="music.cc_a">Todas las canciones son</span>
            <span class="text-accent-green">Creative Commons</span>
            <span data-i18n="music.cc_b">: libres para escuchar y compartir.</span>
          </p>
        </div>
        <a
          href="https://www.jamendo.com"
          target="_blank"
          rel="noopener noreferrer"
          class="sm:ml-auto self-start sm:self-auto px-4 py-2 border border-accent-cyan/50 text-accent-cyan rounded-full hover:bg-accent-cyan/10 transition-all text-sm"
        >
          Jamendo.com →
        </a>
      </div>
    </section>

    <!-- Background decoration -->
    <div
      class="absolute top-20 right-10 w-80 h-80 bg-accent-green/5 rounded-full blur-3xl -z-10"
    >
    </div>
    <div
      class="absolute bottom-40 left-10 w-64 h-64 bg-accent-magenta/5 rounded-full blur-3xl -z-10"
    >
    </div>
  </div>
</Layout>
