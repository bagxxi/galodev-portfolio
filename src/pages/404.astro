---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada | GaloDev Portfolio">
  <div class="relative px-4 md:px-8 py-16 max-w-3xl">
    <span class="metadata block mb-4">// error 404</span>
    <h1
      class="font-display text-4xl md:text-5xl font-bold text-text-bright mb-4"
      data-i18n="notfound.title"
    >
      Página no encontrada
    </h1>
    <p class="text-text-muted text-lg mb-8" data-i18n="notfound.text">
      La página que buscas no existe o fue movida.
    </p>
    <a
      href="/"
      class="inline-flex px-6 py-3 bg-accent-cyan text-void font-semibold rounded-full hover:bg-accent-green transition-colors"
      data-i18n="notfound.back"
    >
      Volver al inicio
    </a>
  </div>
</Layout>
