---
import Layout from "../layouts/Layout.astro";
import { personalInfo, socialLinks } from "@/lib/portfolio";
---

<Layout title="Contacto | GaloDev Portfolio">
  <div class="relative px-4 md:px-8 py-12 max-w-4xl mx-auto">
    <!-- Page header -->
    <header class="mb-12">
      <span class="metadata block mb-4">// contact.send()</span>
      <h1
        class="font-display text-4xl md:text-5xl font-bold text-text-bright mb-4"
      >
        <span class="text-accent-pink">→</span>
        <span data-i18n="contact.title">Contacto</span>
      </h1>
      <p class="text-text-muted text-lg" data-i18n="contact.subtitle">
        ¿Tienes un proyecto en mente? ¡Hablemos!
      </p>
    </header>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Contact Info -->
      <section class="glass-card rounded-xl p-6">
        <h2
          class="font-display text-xl font-bold text-text-bright mb-6 flex items-center gap-2"
        >
          <span class="text-accent-cyan">$</span> info
        </h2>

        <div class="space-y-4">
          <div
            class="flex items-center gap-4 p-3 rounded-lg bg-surface-light/30"
          >
            <span class="text-xl" aria-hidden="true">✉️</span>
            <div>
              <span
                class="text-text-muted text-sm block"
                data-i18n="contact.email_label">Email</span
              >
              <a
                href={`mailto:${personalInfo.email}`}
                class="text-accent-magenta hover:underline"
              >
                {personalInfo.email}
              </a>
            </div>
          </div>

          <div
            class="flex items-center gap-4 p-3 rounded-lg bg-surface-light/30"
          >
            <span class="text-xl" aria-hidden="true">💻</span>
            <div>
              <span
                class="text-text-muted text-sm block"
                data-i18n="contact.github_label">GitHub</span
              >
              <a
                href={personalInfo.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-accent-magenta hover:underline"
              >
                github.com/bagxxi
              </a>
            </div>
          </div>

          <div
            class="flex items-center gap-4 p-3 rounded-lg bg-surface-light/30"
          >
            <span class="text-xl" aria-hidden="true">📍</span>
            <div>
              <span
                class="text-text-muted text-sm block"
                data-i18n="contact.location_label">Ubicación</span
              >
              <span class="text-text">{personalInfo.location}</span>
            </div>
          </div>

          <div
            class="flex items-center gap-4 p-3 rounded-lg bg-surface-light/30"
          >
            <span class="text-xl" aria-hidden="true">🟢</span>
            <div>
              <span
                class="text-text-muted text-sm block"
                data-i18n="contact.status_label">Estado</span
              >
              <span class="text-accent-green" data-i18n="info.status"
                >{personalInfo.status}</span
              >
            </div>
          </div>
        </div>
      </section>

      <!-- Social Links as Playlist -->
      <section class="glass-card rounded-xl p-6">
        <h2
          class="font-display text-xl font-bold text-text-bright mb-6 flex items-center gap-2"
        >
          <span class="text-accent-cyan">$</span> social.links
        </h2>

        <div class="space-y-2">
          {
            socialLinks.map((link, index) => (
              <a
                href={link.url}
                {...(link.url.startsWith("http")
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                class="flex items-center gap-4 p-4 rounded-lg hover:bg-surface-light/50 group transition-all hover:border-accent-cyan/30"
              >
                <span class="text-text-muted text-sm font-mono w-6">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <div class="flex-1">
                  <span class="text-text-bright group-hover:text-accent-cyan transition-colors font-medium">
                    {link.name}
                  </span>
                </div>
                <span class="text-text-muted group-hover:text-accent-magenta transition-colors">
                  →
                </span>
              </a>
            ))
          }
        </div>

        <!-- Terminal style CTA -->
        <div class="mt-6 pt-6">
          <div class="font-mono text-sm text-text-muted">
            <span class="text-accent-cyan">$</span>
            <span data-i18n="contact.response_time">Respondo en</span>
            <span class="text-accent-green">&lt; 24h</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Decorative Terminal -->
    <section class="mt-12 glass-card rounded-xl p-6 hidden md:block">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-3 h-3 rounded-full bg-accent-pink"></div>
        <div class="w-3 h-3 rounded-full bg-accent-orange"></div>
        <div class="w-3 h-3 rounded-full bg-accent-green"></div>
        <span class="text-text-muted text-xs ml-2">message.sh</span>
      </div>
      <pre
        class="font-mono text-sm">
<span class="text-accent-cyan">#!/bin/bash</span>

<span class="text-text-muted"># Opciones de contacto</span>
<span class="text-accent-green">SUBJECT</span>="Proyecto Web"
<span class="text-accent-green">TYPE</span>=["freelance" | "colaboración" | "consultoría"]

<span class="text-text-muted"># Enviar mensaje</span>
<span class="text-accent-magenta">curl</span> -X POST \
  -H "Content-Type: application/json" \
  -d '{"{"}
    "from": "tu@email.com",
    "subject": $SUBJECT,
    "message": "¡Hola GaloDev!"
  {"}"}'  \
  <a href={`mailto:${personalInfo.email}`} class="text-accent-cyan hover:underline">{personalInfo.email}</a>
      </pre>
    </section>

    <!-- Background decoration -->
    <div
      class="absolute top-20 right-10 w-80 h-80 bg-accent-pink/5 rounded-full blur-3xl -z-10"
    >
    </div>
  </div>
</Layout>
