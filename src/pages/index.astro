---
import Layout from "../layouts/Layout.astro";
import { projects, personalInfo, games } from "@/lib/portfolio";

const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
const featuredGame = games[0];
---

<Layout title="GaloDev Portfolio">
  <div id="home-container" class="relative transition-all duration-1000">
    <!-- Hero Section -->
    <section class="relative px-4 md:px-8 pt-10 md:pt-12 pb-8">
      <div class="flex flex-col gap-5 md:gap-6 max-w-4xl">
        <!-- Metadata decorations -->
        <div class="flex flex-wrap gap-x-4 gap-y-2 items-center">
          <span class="badge text-accent-cyan" data-i18n="info.status">
            {personalInfo.status}
          </span>
          <span class="metadata">
            <span data-i18n="about.location_val">{personalInfo.location}</span> ·
            <span data-i18n="about.timezone_val">{personalInfo.timezone}</span>
          </span>
        </div>

        <!-- Main heading -->
        <h1
          class="font-display text-4xl md:text-6xl font-bold text-text-bright leading-tight"
        >
          <span data-i18n="greeting.hello">Hola, soy</span>
          <span class="text-accent-magenta">{personalInfo.displayName}</span>
        </h1>

        <p
          class="text-xl md:text-2xl text-text-muted font-display"
          data-i18n="info.title"
        >
          {personalInfo.title}
        </p>

        <p
          class="text-base md:text-lg text-text max-w-2xl"
          data-i18n="about.description"
        >
          {personalInfo.bio}
        </p>

        <!-- Quick navigation -->
        <div class="flex flex-col sm:flex-row flex-wrap gap-3 sm:gap-4 mt-2">
          <a
            href="/projects"
            class="px-6 py-3 bg-accent-cyan text-void font-semibold rounded-full hover:bg-accent-green transition-all hover:scale-105 flex items-center justify-center sm:min-w-[160px]"
            data-i18n="nav.viewProjects"
          >
            Ver Proyectos
          </a>
          <a
            href="/contact"
            class="px-6 py-3 text-accent-cyan rounded-full border border-accent-cyan/30 hover:bg-accent-cyan/10 transition-all flex items-center justify-center sm:min-w-[160px]"
            data-i18n="nav.contact"
          >
            Contacto
          </a>
        </div>
      </div>

      <!-- Background gradient -->
      <div
        aria-hidden="true"
        class="absolute inset-0 bg-gradient-to-b dark:from-accent-violet/10 from-blue-500/5 via-transparent to-transparent -z-10"
      >
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="px-4 md:px-8 py-6" aria-labelledby="featured-title">
      <div class="flex items-center justify-between gap-4 mb-6">
        <h2
          id="featured-title"
          class="font-display text-2xl font-bold text-text-bright"
          data-i18n="projects.featured"
        >
          Proyectos Destacados
        </h2>
        <a
          href="/projects"
          class="text-sm text-text-muted hover:text-accent-cyan transition-colors shrink-0"
          data-i18n="projects.viewAll"
        >
          Ver todos →
        </a>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {
          featuredProjects.map((project) => (
            <li class="group relative hover:bg-surface-light rounded-lg transition-colors duration-300">
              <a
                href={project.demo || project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex flex-col gap-3 p-3 pb-4 rounded-lg"
              >
                <div class="aspect-video w-full overflow-hidden rounded-md bg-surface-light">
                  <img
                    src={project.cover}
                    alt={`Captura de ${project.title}`}
                    width="1280"
                    height="720"
                    loading="lazy"
                    decoding="async"
                    class="object-cover object-top w-full h-full shadow-xs group-hover:scale-105 transition-transform duration-500"
                    data-fallback="/placeholder.svg"
                  />
                </div>

                <div class="flex flex-col gap-1 px-1">
                  <h3 class="text-text-bright font-semibold">
                    {project.title}
                    <span class="sr-only">(abre en una pestaña nueva)</span>
                  </h3>
                  <span
                    class="text-sm text-text-muted line-clamp-2"
                    data-i18n={`projects.${project.id}.description`}
                  >
                    {project.description}
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Games teaser -->
    {
      featuredGame && (
        <section class="px-4 md:px-8 py-6 pb-10" aria-labelledby="games-title">
          <div class="flex items-center justify-between gap-4 mb-6">
            <h2
              id="games-title"
              class="font-display text-2xl font-bold text-text-bright"
              data-i18n="nav.games"
            >
              Juegos
            </h2>
          </div>
          <a
            href="/games"
            class="glass-card group flex flex-col sm:flex-row sm:items-center gap-4 rounded-xl p-5 hover:bg-surface-light transition-colors"
          >
            <div class="flex-1 min-w-0">
              <h3 class="font-display text-lg font-bold text-text-bright group-hover:text-accent-cyan transition-colors">
                {featuredGame.title}
              </h3>
              <p class="text-sm text-text-muted mt-1" data-i18n="games.teaser">
                Prueba Hospital de Medianoche, un juego 3D que corre directo en
                el navegador.
              </p>
            </div>
            <span
              class="self-start sm:self-auto px-5 py-2 rounded-full bg-accent-magenta text-void font-semibold text-sm"
              data-i18n="games.play"
            >
              Jugar
            </span>
          </a>
        </section>
      )
    }

    <!-- Decorative gradient background -->
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-t from-surface via-surface/80 to-transparent -z-[1] pointer-events-none"
    >
    </div>
  </div>
</Layout>
