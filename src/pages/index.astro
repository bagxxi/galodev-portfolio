---
import Layout from "../layouts/Layout.astro";
import { projects } from "@/lib/portfolio";
import { personalInfo } from "@/lib/portfolio";

// Convert projects to playlist-like format for cards
const featuredProjects = projects.filter((p) => p.featured).slice(0, 3);
---

<Layout title="GaloDev Portfolio">
  <div id="home-container" class="relative transition-all duration-1000">
    <!-- Hero Section -->
    <section class="relative px-8 pt-12 pb-8">
      <div class="flex flex-col gap-6 max-w-4xl">
        <!-- Metadata decorations -->
        <div class="flex gap-4 items-center">
          <span class="badge text-accent-cyan" data-i18n="info.status">
            {personalInfo.status}
          </span>
          <span class="metadata">
            <span data-i18n="about.location_val">{personalInfo.location}</span> •
            <span data-i18n="about.timezone_val">{personalInfo.timezone}</span>
          </span>
        </div>

        <!-- Main heading -->
        <h1
          class="font-display text-4xl md:text-6xl font-bold text-text-bright leading-tight"
        >
          <span data-i18n="greeting.hello">Hola, soy</span>
          <span class="text-accent-magenta">{personalInfo.displayName}</span>
        </h1>

        <p
          class="text-xl md:text-2xl text-text-muted font-display"
          data-i18n="info.title"
        >
          {personalInfo.title}
        </p>

        <p
          class="text-base md:text-lg text-text max-w-2xl"
          data-i18n="about.description"
        >
          {personalInfo.bio}
        </p>

        <!-- Quick navigation -->
        <div class="flex flex-wrap gap-4 mt-4">
          <a
            href="/projects"
            class="px-6 py-3 bg-accent-cyan text-void font-semibold rounded-full hover:bg-accent-green transition-all hover:scale-105 flex items-center justify-center min-w-[160px]"
            data-i18n="nav.viewProjects"
          >
            Ver Proyectos
          </a>
          <a
            href="/contact"
            class="px-6 py-3 text-accent-cyan rounded-full hover:bg-accent-cyan/10 transition-all flex items-center justify-center min-w-[160px]"
            data-i18n="nav.contact"
          >
            Contacto
          </a>
        </div>
      </div>

      <!-- Background gradient -->
      <div
        class="absolute inset-0 bg-gradient-to-b dark:from-accent-violet/10 from-blue-500/5 via-transparent to-transparent -z-10"
      >
      </div>
    </section>

    <!-- Featured Projects -->
    <section class="px-8 py-6">
      <div class="flex items-center justify-between mb-6">
        <h2
          class="font-display text-2xl font-bold text-text-bright"
          data-i18n="projects.featured"
        >
          Proyectos Destacados
        </h2>
        <a
          href="/projects"
          class="text-sm text-text-muted hover:text-accent-cyan transition-colors"
          data-i18n="projects.viewAll"
        >
          Ver todos →
        </a>
      </div>

      <div class="flex flex-wrap gap-4">
        {
          featuredProjects.map((project) => (
            <article class="group relative hover:bg-surface-light rounded-md transition-all duration-300">
              <a
                href={project.demo || project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="flex relative p-3 overflow-hidden gap-2 pb-4 w-48 flex-col"
              >
                <picture class="aspect-square w-full h-auto flex-none">
                  <img
                    src={project.cover}
                    alt={`Cover of ${project.title}`}
                    class="object-cover w-full h-full rounded-md shadow-sm"
                    onerror="this.src='/placeholder.svg'"
                  />
                </picture>

                <div class="flex flex-auto flex-col px-1">
                  <h4 class="text-text-bright text-sm font-semibold">
                    {project.title}
                  </h4>
                  <span
                    class="text-xs text-text-muted line-clamp-2"
                    data-i18n={`projects.${project.id}.description`}
                  >
                    {project.description}
                  </span>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <!-- Decorative gradient background -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-surface via-surface/80 to-transparent -z-[1] pointer-events-none"
    >
    </div>
  </div>
</Layout>
