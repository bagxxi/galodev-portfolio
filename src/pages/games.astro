---
import Layout from "../layouts/Layout.astro";
import { games } from "@/lib/portfolio";
---

<Layout title="Juegos | GaloDev Portfolio">
  <div class="relative px-4 md:px-8 py-12">
    <header class="mb-10 max-w-4xl">
      <span class="metadata block mb-4">// games.play()</span>
      <h1
        class="font-display text-4xl md:text-5xl font-bold text-text-bright mb-4"
        data-i18n="games.title"
      >
        Juegos
      </h1>
      <p class="text-text-muted text-lg" data-i18n="games.subtitle">
        Proyectos jugables hechos con JavaScript. Funcionan en navegador y en
        celular.
      </p>
    </header>

    <div class="flex flex-col gap-10">
      {
        games.map((game) => (
          <article
            class="game-card bg-surface-light/70 rounded-xl overflow-hidden shadow-md"
            aria-labelledby={`${game.id}-title`}
          >
            <div
              class="game-stage relative w-full h-[65dvh] min-h-[360px] md:h-auto md:min-h-0 md:aspect-video bg-black"
              data-src={game.src}
              data-title={game.title}
            >
              <!-- Poster shown until the player starts, so the 3D game isn't loaded on every visit -->
              <button
                type="button"
                class="game-start absolute inset-0 flex flex-col items-center justify-center gap-4 w-full h-full bg-gradient-to-b from-[#0b1020] to-black text-text-bright"
              >
                <span class="font-display text-3xl md:text-4xl font-bold text-center px-4">
                  {game.title}
                </span>
                <span class="flex items-center gap-2 px-6 py-3 rounded-full bg-accent-magenta text-void font-semibold">
                  <svg
                    aria-hidden="true"
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                  >
                    <path d="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713z" />
                  </svg>
                  <span data-i18n="games.play">Jugar</span>
                </span>
              </button>

              <!-- Exit control, only visible while in fullscreen -->
              <button
                type="button"
                class="game-exit hidden absolute z-10 left-1/2 -translate-x-1/2 w-9 h-9 items-center justify-center rounded-full bg-black/60 text-white border border-white/25 opacity-70 hover:opacity-100 focus-visible:opacity-100"
                style="top: max(0.5rem, env(safe-area-inset-top));"
                title="Salir de pantalla completa"
              >
                <svg
                  aria-hidden="true"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                >
                  <path d="M18 6 6 18M6 6l12 12" />
                </svg>
                <span class="sr-only" data-i18n="games.exitFullscreen">
                  Salir de pantalla completa
                </span>
              </button>
            </div>

            <div class="p-5 md:p-6 flex flex-col lg:flex-row lg:items-start gap-5">
              <div class="flex-1 min-w-0">
                <h2
                  id={`${game.id}-title`}
                  class="font-display text-2xl font-bold text-text-bright mb-2"
                >
                  {game.title}
                </h2>
                <p
                  class="text-text-muted mb-3"
                  data-i18n={`games.${game.id}.description`}
                >
                  {game.description.es}
                </p>
                <p class="text-sm text-text mb-4">
                  <span
                    class="font-semibold text-text-bright"
                    data-i18n="games.controls"
                  >
                    Controles
                  </span>
                  :{" "}
                  <span data-i18n={`games.${game.id}.controls`}>
                    {game.controls.es}
                  </span>
                </p>
                <ul class="flex flex-wrap gap-2" aria-label="Tecnologías">
                  {game.tags.map((tag) => (
                    <li class="px-2 py-1 text-xs bg-surface-light rounded-sm text-accent-cyan">
                      {tag}
                    </li>
                  ))}
                </ul>
              </div>

              <div class="flex flex-col sm:flex-row lg:flex-col gap-3 shrink-0">
                <button
                  type="button"
                  class="game-fullscreen flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-accent-cyan text-void font-semibold hover:bg-accent-green transition-colors"
                >
                  <svg
                    aria-hidden="true"
                    width="18"
                    height="18"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
                  </svg>
                  <span data-i18n="games.fullscreen">Pantalla completa</span>
                </button>
                <a
                  href={game.src}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center px-5 py-3 rounded-full border border-accent-cyan/40 text-accent-cyan hover:bg-accent-cyan/10 transition-colors"
                  data-i18n="games.newTab"
                >
                  Abrir en otra pestaña
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Layout>

<style is:global>
  /* Fallback for browsers without the Fullscreen API on arbitrary elements (iPhone Safari) */
  .game-stage.is-pseudo-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    width: 100vw;
    height: 100dvh;
    min-height: 0;
    aspect-ratio: auto;
  }
  html.game-lock,
  html.game-lock body {
    overflow: hidden;
  }
  .game-stage:fullscreen {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .game-stage:fullscreen .game-exit,
  .game-stage.is-pseudo-fullscreen .game-exit {
    display: inline-flex;
  }
</style>

<script>
  type FsElement = HTMLElement & {
    webkitRequestFullscreen?: () => Promise<void> | void;
  };
  type FsDocument = Document & {
    webkitFullscreenElement?: Element | null;
    webkitExitFullscreen?: () => Promise<void> | void;
  };

  const doc = document as FsDocument;

  function fullscreenElement() {
    return doc.fullscreenElement ?? doc.webkitFullscreenElement ?? null;
  }

  function startGame(stage: HTMLElement) {
    let frame = stage.querySelector("iframe");
    if (!frame) {
      frame = document.createElement("iframe");
      // Restrict the game to scripts + its own origin (needed for its localStorage save).
      // Set before `src` so the flags apply to the first navigation.
      // Note: with both flags a same-origin page could lift its own sandbox, so this only
      // hardens first-party games; third-party games must be hosted on a separate origin.
      frame.setAttribute("sandbox", "allow-scripts allow-same-origin");
      frame.allow = "fullscreen; autoplay";
      frame.setAttribute("allowfullscreen", "");
      frame.title = stage.dataset.title ?? "Juego";
      frame.src = stage.dataset.src ?? "";
      frame.className = "absolute inset-0 w-full h-full border-0";
      stage.querySelector(".game-start")?.remove();
      stage.prepend(frame);
    }
    frame.focus();
    return frame;
  }

  async function enterFullscreen(stage: FsElement) {
    const frame = startGame(stage);
    try {
      if (stage.requestFullscreen) {
        await stage.requestFullscreen({ navigationUI: "hide" });
      } else if (stage.webkitRequestFullscreen) {
        await stage.webkitRequestFullscreen();
      } else {
        throw new Error("Fullscreen API unavailable");
      }
    } catch {
      stage.classList.add("is-pseudo-fullscreen");
      document.documentElement.classList.add("game-lock");
    }
    frame.focus();
    stage.querySelector<HTMLButtonElement>(".game-exit")?.blur();
  }

  async function exitFullscreen(stage: HTMLElement) {
    if (stage.classList.contains("is-pseudo-fullscreen")) {
      stage.classList.remove("is-pseudo-fullscreen");
      document.documentElement.classList.remove("game-lock");
    } else if (fullscreenElement()) {
      if (doc.exitFullscreen) await doc.exitFullscreen();
      else await doc.webkitExitFullscreen?.();
    }
    stage
      .closest(".game-card")
      ?.querySelector<HTMLButtonElement>(".game-fullscreen")
      ?.focus();
  }

  function initGames() {
    document.querySelectorAll<HTMLElement>(".game-card").forEach((card) => {
      const stage = card.querySelector<HTMLElement>(".game-stage");
      if (!stage) return;

      card
        .querySelector(".game-start")
        ?.addEventListener("click", () => startGame(stage));
      card
        .querySelector(".game-fullscreen")
        ?.addEventListener("click", () => enterFullscreen(stage));
      card
        .querySelector(".game-exit")
        ?.addEventListener("click", () => exitFullscreen(stage));
    });
  }

  // Escape closes the CSS fallback (native fullscreen handles Escape itself)
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    const stage = document.querySelector<HTMLElement>(".is-pseudo-fullscreen");
    if (stage) exitFullscreen(stage);
  });

  // Clean up if the user navigates away while in the CSS fallback
  document.addEventListener("astro:before-swap", () => {
    document.documentElement.classList.remove("game-lock");
  });

  document.addEventListener("astro:page-load", initGames);
</script>
