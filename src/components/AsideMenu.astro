---
import SectionIcon from "../icons/SectionIcon.astro";
import HomeIcon from "../icons/Home.astro";
import SearchIcon from "../icons/Search.astro";
import SideMenuItem from "./SideMenuItem.astro";
import ThemeLanguageToggle from "./ThemeLanguageToggle.astro";

// Jamendo genre playlists
const genrePlaylists = [
  { id: "metal", title: "Metal", emoji: "🎸", color: "#f7768e" },
  { id: "rock", title: "Rock", emoji: "🔥", color: "#ff9e64" },
  { id: "hiphop", title: "Hip-Hop", emoji: "🎤", color: "#9ece6a" },
  { id: "electronic", title: "Electrónica", emoji: "🎧", color: "#7dcfff" },
  { id: "jazz", title: "Jazz", emoji: "🎷", color: "#bb9af7" },
];
---

<nav aria-label="Principal" class="flex flex-row md:flex-col flex-1 gap-2 h-full">
  <!-- Portfolio Navigation -->
  <div
    class="bg-surface rounded-lg p-1 md:p-2 flex-1 md:flex-none flex flex-row md:flex-col items-center md:items-stretch"
  >
    <ul
      class="flex flex-row md:flex-col justify-around md:justify-start flex-1 min-w-0"
    >
      <SideMenuItem href="/">
        <HomeIcon slot="icon" />
        <span data-i18n="nav.home">Inicio</span>
      </SideMenuItem>
      <SideMenuItem href="/about">
        <SectionIcon type="user" slot="icon" />
        <span data-i18n="nav.about">Sobre mí</span>
      </SideMenuItem>
      <SideMenuItem href="/projects">
        <SectionIcon type="code" slot="icon" />
        <span data-i18n="nav.projects">Proyectos</span>
      </SideMenuItem>
      <SideMenuItem href="/games">
        <SectionIcon type="game" slot="icon" />
        <span data-i18n="nav.games">Juegos</span>
      </SideMenuItem>
      <SideMenuItem href="/skills">
        <SectionIcon type="terminal" slot="icon" />
        <span data-i18n="nav.skills">Skills</span>
      </SideMenuItem>
      <SideMenuItem href="/contact">
        <SectionIcon type="mail" slot="icon" />
        <span data-i18n="nav.contact">Contacto</span>
      </SideMenuItem>
      <!-- Mobile-only Music Link -->
      <SideMenuItem href="/music" class="md:hidden">
        <SectionIcon type="music" slot="icon" />
        <span data-i18n="nav.music">Música</span>
      </SideMenuItem>
    </ul>

    <div class="hidden md:block mt-2 pt-2">
      <ThemeLanguageToggle />
    </div>
    <!-- Mobile version of toggles -->
    <div class="md:hidden flex items-center shrink-0">
      <ThemeLanguageToggle compact />
    </div>
  </div>

  <!-- Music Library (Sidebar only) -->
  <div class="bg-surface rounded-lg p-2 flex-1 overflow-y-auto hidden md:block">
    <div
      class="px-2 md:px-4 py-2 flex items-center justify-center md:justify-start gap-2"
    >
      <SectionIcon type="music" class="text-accent-cyan" />
      <span
        class="font-display font-medium text-text-bright hidden md:inline"
        data-i18n="nav.music">Música</span
      >
    </div>
    <ul>
      <SideMenuItem href="/music">
        <SearchIcon slot="icon" />
        <span data-i18n="nav.discover">Descubrir</span>
      </SideMenuItem>

      <!-- Genre Playlists from Jamendo -->
      <li class="px-2 md:px-4 py-2 mt-2 hidden md:block">
        <span
          class="text-xs text-text-muted uppercase tracking-wide"
          data-i18n="nav.genres">Géneros</span
        >
      </li>

      {
        genrePlaylists.map((genre) => (
          <a
            href={`/genre/${genre.id}`}
            class="playlist-item flex relative p-2 overflow-hidden items-center gap-3 rounded-md hover:bg-surface-light/50 transition-colors hover:border-accent-cyan/20 justify-center md:justify-start text-text"
            title={genre.title}
          >
            <div
              aria-hidden="true"
              class="h-10 w-10 rounded-md flex items-center justify-center text-lg shrink-0"
              style={`background: linear-gradient(135deg, ${genre.color}40, ${genre.color}20);`}
            >
              {genre.emoji}
            </div>
            <div class="flex flex-auto flex-col truncate hidden md:flex">
              <h4 class="text-text-bright text-sm font-medium">
                {genre.title}
              </h4>
              <span class="text-xs text-text-muted">Jamendo</span>
            </div>
          </a>
        ))
      }
    </ul>
  </div>

  <!-- Footer metadata -->
  <div class="px-2 md:px-4 py-2 text-center hidden md:block">
    <span class="metadata hidden md:inline"
      >galodev@portfolio:~$ <span class="text-accent-green">ready</span></span
    >
  </div>
</nav>
