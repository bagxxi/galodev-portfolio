---
interface Props {
  href?: string;
  class?: string;
}

const { href, class: className } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = href === "/" ? path === "/" : path.startsWith(href ?? "");
---

<li class={className}>
  <a
    class:list={[
      "menu-item flex items-center gap-0 md:gap-4 py-3 px-1.5 sm:px-3 md:px-5 font-medium transition duration-300 justify-center md:justify-start rounded-md",
      isActive ? "text-text-bright" : "text-zinc-400 hover:text-text-bright",
    ]}
    href={href}
    aria-current={isActive ? "page" : undefined}
  >
    <span class="menu-icon shrink-0">
      <slot name="icon" />
    </span>
    <!-- Visually hidden on mobile but still announced by screen readers -->
    <span class="menu-text sr-only md:not-sr-only">
      <slot />
    </span>
  </a>
</li>

<style>
  .menu-item:hover,
  .menu-item[aria-current="page"] {
    background: rgba(125, 207, 255, 0.1);
  }
  .menu-item[aria-current="page"] .menu-icon {
    color: var(--color-accent-cyan);
  }
</style>
