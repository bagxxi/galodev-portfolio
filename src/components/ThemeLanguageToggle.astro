---
interface Props {
    compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class:list={["flex items-center gap-2", compact ? "px-1" : "px-4 py-2"]}>
    <!-- Language Toggle -->
    <button
        type="button"
        class="lang-toggle-btn min-h-[40px] px-3 py-1 rounded-md bg-surface border border-text-muted/20 hover:border-accent-magenta/50 text-text-muted hover:text-accent-magenta transition-all text-sm font-mono shadow-xs"
        aria-label="Switch to English"
    >
        EN
    </button>
</div>

<script is:inline>
    // Robust Initialization for multiple instances
    function initLanguageToggles() {
        const langBtns = document.querySelectorAll(".lang-toggle-btn");

        if (langBtns.length === 0) return;

        function updateUI() {
            const currentLang =
                document.documentElement.getAttribute("lang") || "es";
            langBtns.forEach((btn) => {
                btn.textContent = currentLang === "es" ? "EN" : "ES";
                btn.setAttribute(
                    "aria-label",
                    currentLang === "es" ? "Switch to English" : "Cambiar a español",
                );
            });
        }

        langBtns.forEach((btn) => {
            btn.onclick = () => {
                const currentLang =
                    document.documentElement.getAttribute("lang") || "es";
                const newLang = currentLang === "es" ? "en" : "es";

                document.documentElement.setAttribute("lang", newLang);
                localStorage.setItem("lang", newLang);

                // Re-apply translations on this page immediately
                if (window.translatePage) window.translatePage();

                updateUI();
            };
        });

        updateUI();
    }

    // Initial load
    initLanguageToggles();

    // Handle Astro page transitions
    document.addEventListener("astro:after-swap", initLanguageToggles);
</script>
